# ABC permite crear clases abstractas; abstractmethod obliga a implementar métodos en las clases hijas.
from abc import ABC, abstractmethod

# logging registra eventos, advertencias y errores en un archivo de texto.
import logging

# math permite comprobar que los valores numéricos sean finitos.
import math

# Registro persistente de eventos y errores (no es almacenamiento de datos).
# Configuración del log: se guarda en software_fj.log, con fecha, nivel y mensaje.
logging.basicConfig(
    filename="software_fj.log", level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    encoding="utf-8"
)
logger = logging.getLogger("SoftwareFJ")
# --------------------------- FUNCIONES DE VALIDACIÓN -------------------------

# Valida textos que deben contener al menos dos caracteres.
def validar_texto(valor, campo):
    if not isinstance(valor, str) or len(valor.strip()) < 2:
        raise ValidationError(
            f"El {campo} debe contener al menos 2 caracteres."
        )
    return valor.strip()



# Comprueba que un valor sea numérico, finito y del tipo esperado.
def validar_numero(valor, campo, permitir_cero=False):
    if (
        isinstance(valor, bool)
        or not isinstance(valor, (int, float))
        or not math.isfinite(valor)
        or (valor < 0 if permitir_cero else valor <= 0)
    ):
        condicion = "no negativo" if permitir_cero else "positivo"
        raise ValidationError(
            f"El valor de {campo} debe ser un número {condicion} y válido."
        )
    return float(valor)

def validar_porcentaje(valor, campo):
    numero = validar_numero(valor, campo, permitir_cero=True)

    if numero > 100:
        raise ValidationError(
            f"El {campo} debe estar entre 0 y 100."
        )

    return numero


# --------------------------- EXCEPCIONES PERSONALIZADAS ----------------------
# Excepción general de la aplicación. Las demás excepciones heredan de ella.
class SoftwareFJError(Exception):
    """Excepción base del sistema."""


# Se lanza cuando un dato no cumple las reglas de validación.
class ValidationError(SoftwareFJError):
    """Datos de entrada inválidos."""


# Se utiliza cuando se busca un cliente o servicio que no existe.
class NotFoundError(SoftwareFJError):
    """Objeto solicitado no encontrado."""


# Representa una acción que no puede ejecutarse por el estado actual.
class OperationError(SoftwareFJError):
    """Operación no permitida según el estado."""


# Indica que un servicio está marcado como no disponible.
class AvailabilityError(SoftwareFJError):
    """Servicio no disponible."""

# --------------------------- ABSTRACCIÓN -------------------------------------
# CLASE ABSTRACTA: define características comunes para Cliente, Servicio y Reserva.
# ABC impide crear directamente objetos Entidad.
class Entidad(ABC):
    def __init__(self, identificador):
        if not str(identificador).strip():
            raise ValidationError("El identificador no puede estar vacío.")
        self._id = str(identificador).strip()

    @property
    def id(self):
        return self._id

    @abstractmethod
    def describir(self):
        """Cada entidad concreta debe describirse."""

# --------------------------- CLIENTE ----------------------------------------
# Cliente hereda el identificador de Entidad y agrega datos personales encapsulados.
class Cliente(Entidad):
    def __init__(self, identificador, nombre, correo, telefono):
        super().__init__(identificador)
        # Los atributos con doble guion bajo son privados (encapsulación).
        self.__nombre = self._validar_texto(nombre, "nombre")
        self.__correo = self._validar_correo(correo)
        self.__telefono = self._validar_texto(telefono, "teléfono")

    @staticmethod
    def _validar_texto(valor, campo):
        if not isinstance(valor, str) or len(valor.strip()) < 2:
            raise ValidationError(f"El {campo} debe contener al menos 2 caracteres.")
        return valor.strip()

    @staticmethod
    def _validar_correo(correo):
        if not isinstance(correo, str) or "@" not in correo or "." not in correo.split("@")[-1]:
            raise ValidationError("El correo electrónico no tiene un formato válido.")
        return correo.strip().lower()

    @property
    def nombre(self):
        return self.__nombre

    @property
    def correo(self):
        return self.__correo

    @property
    def telefono(self):
        return self.__telefono

    def describir(self):
        return f"Cliente {self.id}: {self.nombre} | {self.correo} | {self.telefono}"

# --------------------------- SERVICIOS --------------------------------------
# Servicio es abstracta: establece una estructura común para los tipos de servicio.
class Servicio(Entidad, ABC):
    def __init__(self, identificador, nombre, tarifa, disponible=True):
        super().__init__(identificador)
        if not isinstance(tarifa, (int, float)) or tarifa <= 0:
            raise ValidationError("La tarifa debe ser un número positivo.")
        self._nombre = Cliente._validar_texto(nombre, "nombre del servicio")
        self._tarifa = float(tarifa)
        self._disponible = bool(disponible)

    @property
    def nombre(self):
        return self._nombre

    @property
    def tarifa(self):
        return self._tarifa

    @property
    def disponible(self):
        return self._disponible

    # Comprueba duración y disponibilidad antes de calcular o reservar.
    def validar_parametros(self, duracion):
        if not isinstance(duracion, (int, float)) or duracion <= 0:
            raise ValidationError("La duración debe ser un número positivo.")
        if not self.disponible:
            raise AvailabilityError(f"El servicio '{self.nombre}' no está disponible.")

    @abstractmethod
    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        pass

    @abstractmethod
    def describir(self):
        pass

# Servicio concreto 1: reserva de salas. Sobrescribe cálculo y descripción.
class ReservaSala(Servicio):
    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        self.validar_parametros(duracion)
        return costo_final(self.tarifa * duracion, descuento, impuesto)

    def describir(self):
        return f"Reserva de sala: {self.nombre} (${self.tarifa:.2f}/hora)"


# Servicio concreto 2: alquiler de equipos. Aplica tarifa por día.
class AlquilerEquipo(Servicio):
    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        self.validar_parametros(duracion)
        # La duración representa días de alquiler.
        return costo_final(self.tarifa * duracion, descuento, impuesto)

    def describir(self):
        return f"Alquiler de equipo: {self.nombre} (${self.tarifa:.2f}/día)"


# Servicio concreto 3: asesorías. Aplica tarifa por hora.
class Asesoria(Servicio):
    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        self.validar_parametros(duracion)
        # La duración representa horas de asesoría.
        return costo_final(self.tarifa * duracion, descuento, impuesto)

    def describir(self):
        return f"Asesoría especializada: {self.nombre} (${self.tarifa:.2f}/hora)"

# --------------------------- SOBRECARGA SIMULADA ----------------------------
# Python no permite sobrecarga clásica por firma. Se implementan variantes
# mediante argumentos opcionales y un método alternativo explícito.
# Calcula el valor final: primero aplica descuento y luego impuesto.\n# Los parámetros opcionales permiten distintas formas de cálculo (sobrecarga simulada).
def costo_final(subtotal, descuento=0, impuesto=0):
    if not 0 <= descuento <= 100:
        raise ValidationError("El descuento debe estar entre 0 y 100%.")
    if not 0 <= impuesto <= 100:
        raise ValidationError("El impuesto debe estar entre 0 y 100%.")
    base = subtotal * (1 - descuento / 100)
    return round(base * (1 + impuesto / 100), 2)


# Variante sencilla: costo sin descuento ni impuesto.
def calcular_costo_simple(servicio, duracion):
    """Variante 1: costo sin descuento ni impuesto."""
    return servicio.calcular_costo(duracion)


# Variante detallada: recibe descuento e impuesto.
def calcular_costo_detallado(servicio, duracion, descuento, impuesto):
    """Variante 2: costo con descuento e impuesto."""
    return servicio.calcular_costo(duracion, descuento, impuesto)

# --------------------------- RESERVA ----------------------------------------
# Reserva relaciona un Cliente con un Servicio, duración, estado y costo.
class Reserva(Entidad):
    ESTADOS = ("Pendiente", "Confirmada", "Cancelada")

    def __init__(self, identificador, cliente, servicio, duracion):
        super().__init__(identificador)
        if not isinstance(cliente, Cliente):
            raise ValidationError("La reserva requiere un cliente válido.")
        if not isinstance(servicio, Servicio):
            raise ValidationError("La reserva requiere un servicio válido.")
        servicio.validar_parametros(duracion)
        self._cliente = cliente
        self._servicio = servicio
        self._duracion = duracion
        self._estado = "Pendiente"
        self._costo = None

    @property
    def estado(self):
        return self._estado

    @property
    def costo(self):
        return self._costo

    # Confirma una reserva pendiente y calcula su costo.
    def confirmar(self, descuento=0, impuesto=0):
        if self._estado != "Pendiente":
            raise OperationError("Solo se puede confirmar una reserva pendiente.")
        try:
            self._costo = self._servicio.calcular_costo(self._duracion, descuento, impuesto)
        except (ValidationError, AvailabilityError) as exc:
            raise OperationError("No fue posible calcular/confirmar la reserva.") from exc
        else:
            self._estado = "Confirmada"
            logger.info("Reserva %s confirmada. Costo=%s", self.id, self._costo)
        finally:
            logger.info("Proceso de confirmación finalizado para reserva %s", self.id)

    def cancelar(self):
        if self._estado == "Cancelada":
            raise OperationError("La reserva ya está cancelada.")
        self._estado = "Cancelada"
        logger.info("Reserva %s cancelada.", self.id)

    def procesar(self):
        if self._estado != "Confirmada":
            raise OperationError("La reserva debe estar confirmada para procesarse.")
        return f"Reserva {self.id} procesada correctamente."

    def describir(self):
        return (f"Reserva {self.id} | Cliente: {self._cliente.nombre} | "
                f"Servicio: {self._servicio.nombre} | Duración: {self._duracion} | "
                f"Estado: {self.estado} | Costo: {self._costo}")

# --------------------------- GESTOR EN MEMORIA ------------------------------
# Gestor principal: mantiene listas en memoria, sin base de datos.
class SistemaSoftwareFJ:
    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []

    # Registra clientes y evita identificadores repetidos.
    def registrar_cliente(self, cliente):
        if any(c.id == cliente.id for c in self.clientes):
            raise ValidationError(f"Ya existe el cliente con ID {cliente.id}.")
        self.clientes.append(cliente)
        logger.info("Cliente registrado: %s", cliente.id)

    # Registra servicios y evita identificadores repetidos.
    def registrar_servicio(self, servicio):
        if any(s.id == servicio.id for s in self.servicios):
            raise ValidationError(f"Ya existe el servicio con ID {servicio.id}.")
        self.servicios.append(servicio)
        logger.info("Servicio registrado: %s", servicio.id)

    # Busca cliente y servicio en las listas; si existen, crea la reserva.
    def crear_reserva(self, identificador, id_cliente, id_servicio, duracion):
        cliente = next((c for c in self.clientes if c.id == str(id_cliente)), None)
        servicio = next((s for s in self.servicios if s.id == str(id_servicio)), None)
        if cliente is None:
            raise NotFoundError(f"No existe el cliente {id_cliente}.")
        if servicio is None:
            raise NotFoundError(f"No existe el servicio {id_servicio}.")
        reserva = Reserva(identificador, cliente, servicio, duracion)
        self.reservas.append(reserva)
        logger.info("Reserva creada: %s", reserva.id)
        return reserva

    def listar(self):
        print("\\n--- CLIENTES ---")
        for c in self.clientes: print(c.describir())
        print("\\n--- SERVICIOS ---")
        for s in self.servicios: print(s.describir())
        print("\\n--- RESERVAS ---")
        for r in self.reservas: print(r.describir())


# --------------------------- DEMOSTRACIÓN (10+ OPERACIONES) ------------------
# Ejecuta casos válidos e inválidos para demostrar que el programa continúa.
def ejecutar_demostracion():
    sistema = SistemaSoftwareFJ()
    print("SISTEMA INTEGRAL SOFTWARE FJ\\n")
    operaciones = 0

    # Función auxiliar: cada acción se ejecuta con control de excepciones.
    def ejecutar(etiqueta, accion):
        nonlocal operaciones
        operaciones += 1
        try:
            resultado = accion()
        except SoftwareFJError as exc:
            logger.error("%s: %s", etiqueta, exc, exc_info=True)
            print(f"[ERROR CONTROLADO] {etiqueta}: {exc}")
        except Exception as exc:
            # Captura de último recurso: evita que un error inesperado cierre la app.
            logger.critical("%s: error inesperado", etiqueta, exc_info=True)
            print(f"[ERROR INESPERADO CONTROLADO] {etiqueta}: {exc}")
        else:
            print(f"[OK] {etiqueta}" + (f" -> {resultado}" if resultado is not None else ""))
        finally:
            print(f"Operación {operaciones} finalizada.")

# 1 y 2: clientes válido e inválido
    ejecutar("Registrar cliente válido",
             lambda: sistema.registrar_cliente(Cliente("C01", "Ana Pérez", "ana@mail.com", "3001234567")))
    ejecutar("Registrar cliente inválido",
             lambda: sistema.registrar_cliente(Cliente("C02", "A", "correo-invalido", "3")))

    # 3 y 4: servicios correctos e incorrectos
    ejecutar("Crear servicio sala",
             lambda: sistema.registrar_servicio(ReservaSala("S01", "Sala de reuniones", 50000)))
    ejecutar("Crear servicio equipo",
             lambda: sistema.registrar_servicio(AlquilerEquipo("S02", "Proyector", 30000)))
    ejecutar("Crear servicio asesoría",
             lambda: sistema.registrar_servicio(Asesoria("S03", "Asesoría técnica", 80000)))
    ejecutar("Crear servicio con tarifa inválida",
             lambda: sistema.registrar_servicio(Asesoria("S04", "Asesoría inválida", -10)))

    # 7: reserva exitosa, confirmación y procesamiento
    reserva_ok = {}
    def crear_y_confirmar():
        r = sistema.crear_reserva("R01", "C01", "S01", 2)
        reserva_ok["r"] = r
        r.confirmar(descuento=10, impuesto=19)
        return f"Costo ${r.costo}"
    ejecutar("Reserva exitosa", crear_y_confirmar)
    ejecutar("Procesar reserva confirmada", lambda: reserva_ok["r"].procesar())

    # 9 y 10: reserva fallida y operación no permitida
    ejecutar("Reserva con cliente inexistente",
             lambda: sistema.crear_reserva("R02", "C99", "S01", 1))
    ejecutar("Procesar reserva pendiente",
             lambda: sistema.crear_reserva("R03", "C01", "S02", 1).procesar())

    # 11: servicio no disponible
    ejecutar("Reserva de servicio no disponible",
             lambda: Reserva("R04", sistema.clientes[0],
                            Asesoria("S05", "No disponible", 50000, False), 1))

    # 12: parámetros/cálculo inconsistentes
    ejecutar("Duración inválida",
             lambda: sistema.crear_reserva("R05", "C01", "S01", 0))
    ejecutar("Descuento inválido",
             lambda: calcular_costo_detallado(sistema.servicios[0], 1, 150, 19))

    # 13: cancelar una reserva
    ejecutar("Cancelar reserva",
             lambda: reserva_ok["r"].cancelar())

    sistema.listar()
    print(f"\\nDemostración terminada: {operaciones} operaciones ejecutadas.")
    print("Los eventos y errores se guardaron en software_fj.log.")

# Este bloque solo se ejecuta cuando el archivo se inicia directamente.
if __name__ == "__main__":
    ejecutar_demostracion()

    






