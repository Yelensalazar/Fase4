# ABC permite crear clases abstractas; abstractmethod obliga a implementar métodos en las clases hijas.
from abc import ABC, abstractmethod

# logging registra eventos, advertencias y errores en un archivo de texto.
import logging

# math permite comprobar que los valores numéricos sean finitos.
import math

# Registro persistente de eventos y errores (no es almacenamiento de datos).
# Configuración del log: se guarda en software_fj.log, con fecha, nivel y mensaje.
logging.basicConfig(
    filename="software_fj.log",
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    encoding="utf-8"
)
# Crea el registrador que utilizará el sistema Software FJ.
logger = logging.getLogger("SoftwareFJ")
# --------------------------- FUNCIONES DE VALIDACIÓN -------------------------

# Valida textos que deben contener al menos dos caracteres.
def validar_texto(valor, campo):
    if not isinstance(valor, str) or len(valor.strip()) < 2:
        raise ValidationError(
            f"El {campo} debe contener al menos 2 caracteres."
        )
    return valor.strip()



# Comprueba que un valor sea numérico, finito y del tipo esperado.
def validar_numero(valor, campo, permitir_cero=False):
    

     # Rechaza valores booleanos y tipos que no sean numéricos.
    # Se excluyen True y False porque Python los considera números.
    if isinstance(valor, bool) or not isinstance(valor, (int, float)):
        raise ValidationError(
            f"El campo {campo} debe ser numérico."
        )

    # Convierte el valor a número decimal.
    # Si ocurre un error, se genera una excepción personalizada.
    
    try:
        numero = float(valor)

    except (ValueError, OverflowError) as exc:
        raise ValidationError(
            f"El campo {campo} contiene un número inválido."
        ) from exc

    # Comprueba que el número sea finito.
    if not math.isfinite(numero):
        raise ValidationError(
            f"El campo {campo} debe ser un número finito."
        )

    # Comprueba si se permite cero o si debe ser positivo.
    if permitir_cero:
        if numero < 0:
            raise ValidationError(
                f"El campo {campo} no puede ser negativo."
            )
    elif numero <= 0:
        raise ValidationError(
            f"El campo {campo} debe ser positivo."
        )

    return numero


def validar_porcentaje(valor, campo):
    """Valida que el porcentaje esté entre 0 y 100."""

    numero = validar_numero(
        valor,
        campo,
        permitir_cero=True
    )

    if numero > 100:
        raise ValidationError(
            f"El {campo} debe estar entre 0 y 100."
        )

    return numero


# --------------------------- EXCEPCIONES PERSONALIZADAS ----------------------
# Excepción general de la aplicación. Las demás excepciones heredan de ella.
class SoftwareFJError(Exception):
    """Excepción base del sistema."""


# Se lanza cuando un dato no cumple las reglas de validación.
class ValidationError(SoftwareFJError):
    """Datos de entrada inválidos."""


# Se utiliza cuando se busca un cliente o servicio que no existe.
class NotFoundError(SoftwareFJError):
    """Objeto solicitado no encontrado."""


# Representa una acción que no puede ejecutarse por el estado actual.
class OperationError(SoftwareFJError):
    """Operación no permitida según el estado."""


# Indica que un servicio está marcado como no disponible.
class AvailabilityError(SoftwareFJError):
    """Servicio no disponible."""

# --------------------------- ABSTRACCIÓN -------------------------------------
# CLASE ABSTRACTA: define características comunes para Cliente, Servicio y Reserva.
# ABC impide crear directamente objetos Entidad.
class Entidad(ABC):
    """Clase abstracta que establece características comunes."""

    def __init__(self, identificador):

        if identificador is None or not str(identificador).strip():
            raise ValidationError(
                "El identificador no puede estar vacío."
            )

        self._id = str(identificador).strip()

    @property
    def id(self):
        return self._id

    @abstractmethod
    def describir(self):
        """Cada entidad concreta debe implementar su descripción."""


# --------------------------- CLIENTE ----------------------------------------
# Cliente hereda el identificador de Entidad y agrega datos personales encapsulados.
class Cliente(Entidad):
    def __init__(self, identificador, nombre, correo, telefono):
        super().__init__(identificador)
        # Los atributos con doble guion bajo son privados (encapsulación).
        self.__nombre = self._validar_texto(nombre, "nombre")
        self.__correo = self._validar_correo(correo)
        self.__telefono = self._validar_texto(telefono, "teléfono")

    @staticmethod
    def _validar_texto(valor, campo):
        if not isinstance(valor, str) or len(valor.strip()) < 2:
            raise ValidationError(f"El {campo} debe contener al menos 2 caracteres.")
        return valor.strip()

    @staticmethod
    def _validar_correo(correo):

        if not isinstance(correo, str):
            raise ValidationError("El correo debe ser texto.")

        correo = correo.strip().lower()
        partes = correo.split("@")

        if len(partes) != 2:
            raise ValidationError(
                "El correo no tiene un formato válido."
            )

        usuario, dominio = partes

        if (
            not usuario
            or not dominio
            or "." not in dominio
            or dominio.startswith(".")
            or dominio.endswith(".")
        ):
            raise ValidationError(
                "El correo no tiene un formato válido."
            )

        return correo

    @staticmethod
    def _validar_telefono(telefono):

        if not isinstance(telefono, str):
            raise ValidationError("El teléfono debe ser texto.")

        telefono = telefono.strip()

        # Permite espacios y guiones como separadores.
        digitos = telefono.replace(" ", "").replace("-", "")

        if not digitos.isdigit() or not 7 <= len(digitos) <= 15:
            raise ValidationError(
                "El teléfono debe contener entre 7 y 15 dígitos."
            )

        return telefono

    @property
    def nombre(self):
        return self.__nombre

    @property
    def correo(self):
        return self.__correo

    @property
    def telefono(self):
        return self.__telefono

    def describir(self):
        return (
            f"Cliente {self.id}: {self.nombre} | "
            f"{self.correo} | {self.telefono}"
        )


# --------------------------- SERVICIOS --------------------------------------
# Servicio es abstracta: establece una estructura común para los tipos de servicio.
class Servicio(Entidad, ABC):
    

    def __init__(self, identificador, nombre, tarifa, disponible=True):

        super().__init__(identificador)

        self._nombre = validar_texto(nombre, "nombre del servicio")
        self._tarifa = validar_numero(tarifa, "tarifa")

        if not isinstance(disponible, bool):
            raise ValidationError(
                "La disponibilidad debe ser un valor booleano."
            )

        self._disponible = disponible

    @property
    def nombre(self):
        return self._nombre

    @property
    def tarifa(self):
        return self._tarifa

    @property
    def disponible(self):
        return self._disponible

    def validar_parametros(self, duracion):
        """Comprueba la duración y disponibilidad del servicio."""

        validar_numero(duracion, "duración")

        if not self.disponible:
            raise AvailabilityError(
                f"El servicio '{self.nombre}' no está disponible."
            )

    @abstractmethod
    def calcular_costo(self, duracion, descuento=0, impuesto=0):
        pass

    @abstractmethod
    def describir(self):
        pass


class ReservaSala(Servicio):
    """Servicio de reserva de salas por hora."""

    def calcular_costo(self, duracion, descuento=0, impuesto=0):

        self.validar_parametros(duracion)

        return costo_final(
            self.tarifa * duracion,
            descuento,
            impuesto
        )

    def describir(self):
        return (
            f"Reserva de sala: {self.nombre} "
            f"(${self.tarifa:.2f}/hora)"
        )


class AlquilerEquipo(Servicio):
    """Servicio de alquiler de equipos por día."""

    def calcular_costo(self, duracion, descuento=0, impuesto=0):

        self.validar_parametros(duracion)

        return costo_final(
            self.tarifa * duracion,
            descuento,
            impuesto
        )

    def describir(self):
        return (
            f"Alquiler de equipo: {self.nombre} "
            f"(${self.tarifa:.2f}/día)"
        )


class Asesoria(Servicio):
    """Servicio de asesorías especializadas por hora."""

    def calcular_costo(self, duracion, descuento=0, impuesto=0):

        self.validar_parametros(duracion)

        return costo_final(
            self.tarifa * duracion,
            descuento,
            impuesto
        )

    def describir(self):
        return (
            f"Asesoría especializada: {self.nombre} "
            f"(${self.tarifa:.2f}/hora)"
        )


# --------------------------- SOBRECARGA SIMULADA ----------------------------
# Python no permite sobrecarga clásica por firma. Se implementan variantes
# mediante argumentos opcionales y un método alternativo explícito.
# Calcula el valor final: primero aplica descuento y luego impuesto.\n# Los parámetros opcionales permiten distintas formas de cálculo (sobrecarga simulada).
def costo_final(subtotal, descuento=0, impuesto=0):

    subtotal = validar_numero(subtotal, "subtotal")
    descuento = validar_porcentaje(descuento, "descuento")
    impuesto = validar_porcentaje(impuesto, "impuesto")

    base = subtotal * (1 - descuento / 100)

    total = base * (1 + impuesto / 100)

    if not math.isfinite(total):
        raise ValidationError("El resultado del cálculo no es válido.")

    return round(total, 2)


# Variante sencilla: costo sin descuento ni impuesto.
def calcular_costo_simple(servicio, duracion):
    """Variante 1: costo sin descuento ni impuesto."""
    return servicio.calcular_costo(duracion)


# Variante detallada: recibe descuento e impuesto.
def calcular_costo_detallado(servicio, duracion, descuento, impuesto):
    """Variante 2: costo con descuento e impuesto."""
    return servicio.calcular_costo(duracion, descuento, impuesto)

# --------------------------- RESERVA ----------------------------------------
# Reserva relaciona un Cliente con un Servicio, duración, estado y costo.
class Reserva(Entidad):
    """Relaciona un cliente con un servicio y administra su estado."""

    ESTADOS = (
        "Pendiente",
        "Confirmada",
        "Cancelada",
        "Procesada"
    )

    def __init__(self, identificador, cliente, servicio, duracion):

        super().__init__(identificador)

        if not isinstance(cliente, Cliente):
            raise ValidationError(
                "La reserva requiere un cliente válido."
            )

        if not isinstance(servicio, Servicio):
            raise ValidationError(
                "La reserva requiere un servicio válido."
            )

        servicio.validar_parametros(duracion)

        self._cliente = cliente
        self._servicio = servicio
        self._duracion = validar_numero(duracion, "duración")
        self._estado = "Pendiente"
        self._costo = None

    @property
    def estado(self):
        return self._estado

    @property
    def costo(self):
        return self._costo
    
# Confirma una reserva pendiente y calcula su costo.
    def confirmar(self, descuento=0, impuesto=0):
        """Confirma una reserva pendiente y calcula su costo."""

        if self._estado != "Pendiente":
            raise OperationError(
                "Solo se puede confirmar una reserva pendiente."
            )

        try:
            self._costo = self._servicio.calcular_costo(
                self._duracion,
                descuento,
                impuesto
            )

        except (ValidationError, AvailabilityError) as exc:

            logger.error(
                "Error al confirmar reserva %s: %s",
                self.id,
                exc,
                exc_info=True
            )

            raise OperationError(
                "No fue posible calcular o confirmar la reserva."
            ) from exc

        else:
            self._estado = "Confirmada"

            logger.info(
                "Reserva %s confirmada. Costo=%s",
                self.id,
                self._costo
            )

        finally:
            logger.info(
                "Proceso de confirmación finalizado para reserva %s",
                self.id
            )

    def cancelar(self):
        """Cancela una reserva pendiente o confirmada."""

        if self._estado == "Cancelada":
            raise OperationError(
                "La reserva ya está cancelada."
            )

        if self._estado == "Procesada":
            raise OperationError(
                "No se puede cancelar una reserva que ya fue procesada."
            )

        self._estado = "Cancelada"

        logger.info("Reserva %s cancelada.", self.id)

    def procesar(self):
        """Procesa una reserva que haya sido confirmada."""

        if self._estado != "Confirmada":
            raise OperationError(
                "La reserva debe estar confirmada para procesarse."
            )

        self._estado = "Procesada"

        logger.info(
            "Reserva %s procesada correctamente.",
            self.id
        )

        return f"Reserva {self.id} procesada correctamente."

    def describir(self):

        return (
            f"Reserva {self.id} | "
            f"Cliente: {self._cliente.nombre} | "
            f"Servicio: {self._servicio.nombre} | "
            f"Duración: {self._duracion} | "
            f"Estado: {self.estado} | "
            f"Costo: {self._costo}"
        )

# --------------------------- GESTOR EN MEMORIA ------------------------------
class SistemaSoftwareFJ:
    """Administra clientes, servicios y reservas en listas en memoria."""

    def __init__(self):

        self.clientes = []
        self.servicios = []
        self.reservas = []
# Registra clientes y evita identificadores repetidos.
    def registrar_cliente(self, cliente):
        

        if not isinstance(cliente, Cliente):
            raise ValidationError(
                "Solo se pueden registrar objetos de tipo Cliente."
            )

        if any(c.id == cliente.id for c in self.clientes):
            raise ValidationError(
                f"Ya existe el cliente con ID {cliente.id}."
            )

        self.clientes.append(cliente)

        logger.info("Cliente registrado: %s", cliente.id)

    def registrar_servicio(self, servicio):
        """Registra servicios y evita identificadores repetidos."""

        if not isinstance(servicio, Servicio):
            raise ValidationError(
                "Solo se pueden registrar objetos de tipo Servicio."
            )

        if any(s.id == servicio.id for s in self.servicios):
            raise ValidationError(
                f"Ya existe el servicio con ID {servicio.id}."
            )

        self.servicios.append(servicio)

        logger.info("Servicio registrado: %s", servicio.id)

    def crear_reserva(
        self,
        identificador,
        id_cliente,
        id_servicio,
        duracion
    ):
        """Busca cliente y servicio y crea una reserva."""

        id_reserva = str(identificador).strip()
        id_cliente = str(id_cliente).strip()
        id_servicio = str(id_servicio).strip()

        if not id_reserva:
            raise ValidationError(
                "El identificador de la reserva no puede estar vacío."
            )

        if any(r.id == id_reserva for r in self.reservas):
            raise ValidationError(
                f"Ya existe una reserva con ID {id_reserva}."
            )

        cliente = next(
            (c for c in self.clientes if c.id == id_cliente),
            None
        )

        servicio = next(
            (s for s in self.servicios if s.id == id_servicio),
            None
        )

        if cliente is None:
            raise NotFoundError(
                f"No existe el cliente {id_cliente}."
            )

        if servicio is None:
            raise NotFoundError(
                f"No existe el servicio {id_servicio}."
            )

        reserva = Reserva(
            id_reserva,
            cliente,
            servicio,
            duracion
        )

        self.reservas.append(reserva)

        logger.info("Reserva creada: %s", reserva.id)

        return reserva

    def listar(self):
        """Muestra los clientes, servicios y reservas registrados."""

        print("\n--- CLIENTES ---")

        for cliente in self.clientes:
            print(cliente.describir())

        print("\n--- SERVICIOS ---")

        for servicio in self.servicios:
            print(servicio.describir())

        print("\n--- RESERVAS ---")

        for reserva in self.reservas:
            print(reserva.describir())

# --------------------------- DEMOSTRACIÓN (10+ OPERACIONES) ------------------
# Ejecuta casos válidos e inválidos para demostrar que el programa continúa.
def ejecutar_demostracion():


    sistema = SistemaSoftwareFJ()

    print("SISTEMA INTEGRAL SOFTWARE FJ\n")

    operaciones = 0

    # Función auxiliar: cada acción se ejecuta con control de excepciones.
    def ejecutar(etiqueta, accion):

        nonlocal operaciones
        operaciones += 1

        try:
            resultado = accion()

        except SoftwareFJError as exc:

            logger.error(
                "%s: %s",
                etiqueta,
                exc,
                exc_info=True
            )

            print(
                f"[ERROR CONTROLADO] {etiqueta}: {exc}"
            )

        except Exception as exc:

            logger.critical(
                "%s: error inesperado",
                etiqueta,
                exc_info=True
            )

            print(
                f"[ERROR INESPERADO CONTROLADO] {etiqueta}: {exc}"
            )

        else:

            mensaje = (
                f" -> {resultado}"
                if resultado is not None
                else ""
            )

            print(f"[OK] {etiqueta}{mensaje}")

        finally:
            print(f"Operación {operaciones} finalizada.")

    # 1. Registrar un cliente válido.
    ejecutar(
        "Registrar cliente válido",
        lambda: sistema.registrar_cliente(
            Cliente(
                "C01",
                "Ana Pérez",
                "ana@mail.com",
                "3001234567"
            )
        )
    )

    # 2. Intentar registrar un cliente con datos inválidos.
    ejecutar(
        "Registrar cliente inválido",
        lambda: sistema.registrar_cliente(
            Cliente(
                "C02",
                "A",
                "correo-invalido",
                "3"
            )
        )
    )

    # 3. Registrar un servicio de sala.
    ejecutar(
        "Crear servicio sala",
        lambda: sistema.registrar_servicio(
            ReservaSala(
                "S01",
                "Sala de reuniones",
                50000
            )
        )
    )

    # 4. Registrar un servicio de alquiler de equipo.
    ejecutar(
        "Crear servicio equipo",
        lambda: sistema.registrar_servicio(
            AlquilerEquipo(
                "S02",
                "Proyector",
                30000
            )
        )
    )

    # 5. Registrar un servicio de asesoría.
    ejecutar(
        "Crear servicio asesoría",
        lambda: sistema.registrar_servicio(
            Asesoria(
                "S03",
                "Asesoría técnica",
                80000
            )
        )
    )

    # 6. Intentar crear un servicio con tarifa inválida.
    ejecutar(
        "Crear servicio con tarifa inválida",
        lambda: sistema.registrar_servicio(
            Asesoria(
                "S04",
                "Asesoría inválida",
                -10
            )
        )
    )

    # 7. Crear y confirmar una reserva.
    reserva_ok = {}

    def crear_y_confirmar():

        r = sistema.crear_reserva(
            "R01",
            "C01",
            "S01",
            2
        )

        reserva_ok["r"] = r

        r.confirmar(
            descuento=10,
            impuesto=19
        )

        return f"Costo ${r.costo}"

    ejecutar(
        "Crear y confirmar reserva",
        crear_y_confirmar
    )

    # 8. Procesar la reserva confirmada.
    ejecutar(
        "Procesar reserva confirmada",
        lambda: reserva_ok["r"].procesar()
    )

    # 9. Intentar crear una reserva con cliente inexistente.
    ejecutar(
        "Reserva con cliente inexistente",
        lambda: sistema.crear_reserva(
            "R02",
            "C99",
            "S01",
            1
        )
    )

    # 10. Intentar procesar una reserva pendiente.
    ejecutar(
        "Procesar reserva pendiente",
        lambda: sistema.crear_reserva(
            "R03",
            "C01",
            "S02",
            1
        ).procesar()
    )

    # 11. Intentar reservar un servicio no disponible.
    ejecutar(
        "Reserva de servicio no disponible",
        lambda: Reserva(
            "R04",
            sistema.clientes[0],
            Asesoria(
                "S05",
                "No disponible",
                50000,
                False
            ),
            1
        )
    )

    # 12. Intentar crear una reserva con duración inválida.
    ejecutar(
        "Duración inválida",
        lambda: sistema.crear_reserva(
            "R05",
            "C01",
            "S01",
            0
        )
    )

    # 13. Intentar calcular un costo con descuento inválido.
    ejecutar(
        "Descuento inválido",
        lambda: calcular_costo_detallado(
            sistema.servicios[0],
            1,
            150,
            19
        )
    )

    # 14. Intentar cancelar una reserva que ya fue procesada.
    ejecutar(
        "Intentar cancelar reserva procesada",
        lambda: reserva_ok["r"].cancelar()
    )

    # 15. Crear una reserva independiente para cancelarla.
    reserva_cancelable = {}

    def crear_reserva_cancelable():

        r = sistema.crear_reserva(
            "R06",
            "C01",
            "S02",
            1
        )

        reserva_cancelable["r"] = r

        return r.id

    ejecutar(
        "Crear reserva para cancelar",
        crear_reserva_cancelable
    )

    # 16. Cancelar la reserva que se encuentra pendiente.
    ejecutar(
        "Cancelar reserva pendiente",
        lambda: reserva_cancelable["r"].cancelar()
    )

    # Mostrar los registros del sistema.
    sistema.listar()

    print(
        f"\nDemostración terminada: "
        f"{operaciones} operaciones ejecutadas."
    )

    print(
        "Los eventos y errores se guardaron en software_fj.log."
    )


# --------------------------- PUNTO DE ENTRADA --------------------------------

if __name__ == "__main__":
    ejecutar_demostracion()



