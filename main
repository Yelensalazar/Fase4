# ABC permite crear clases abstractas; abstractmethod obliga a implementar métodos en las clases hijas.
from abc import ABC, abstractmethod

# logging registra eventos, advertencias y errores en un archivo de texto.
import logging

# Registro persistente de eventos y errores (no es almacenamiento de datos).
# Configuración del log: se guarda en software_fj.log, con fecha, nivel y mensaje.
logging.basicConfig(
    filename="software_fj.log", level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
    encoding="utf-8"
)
logger = logging.getLogger("SoftwareFJ")


# --------------------------- EXCEPCIONES PERSONALIZADAS ----------------------
# Excepción general de la aplicación. Las demás excepciones heredan de ella.
class SoftwareFJError(Exception):
    """Excepción base del sistema."""


# Se lanza cuando un dato no cumple las reglas de validación.
class ValidationError(SoftwareFJError):
    """Datos de entrada inválidos."""


# Se utiliza cuando se busca un cliente o servicio que no existe.
class NotFoundError(SoftwareFJError):
    """Objeto solicitado no encontrado."""


# Representa una acción que no puede ejecutarse por el estado actual.
class OperationError(SoftwareFJError):
    """Operación no permitida según el estado."""


# Indica que un servicio está marcado como no disponible.
class AvailabilityError(SoftwareFJError):
    """Servicio no disponible."""

# --------------------------- ABSTRACCIÓN -------------------------------------
# CLASE ABSTRACTA: define características comunes para Cliente, Servicio y Reserva.
# ABC impide crear directamente objetos Entidad.
class Entidad(ABC):
    def __init__(self, identificador):
        if not str(identificador).strip():
            raise ValidationError("El identificador no puede estar vacío.")
        self._id = str(identificador).strip()

    @property
    def id(self):
        return self._id

    @abstractmethod
    def describir(self):
        """Cada entidad concreta debe describirse."""

# --------------------------- CLIENTE ----------------------------------------
# Cliente hereda el identificador de Entidad y agrega datos personales encapsulados.
class Cliente(Entidad):
    def __init__(self, identificador, nombre, correo, telefono):
        super().__init__(identificador)
        # Los atributos con doble guion bajo son privados (encapsulación).
        self.__nombre = self._validar_texto(nombre, "nombre")
        self.__correo = self._validar_correo(correo)
        self.__telefono = self._validar_texto(telefono, "teléfono")

    @staticmethod
    def _validar_texto(valor, campo):
        if not isinstance(valor, str) or len(valor.strip()) < 2:
            raise ValidationError(f"El {campo} debe contener al menos 2 caracteres.")
        return valor.strip()

    @staticmethod
    def _validar_correo(correo):
        if not isinstance(correo, str) or "@" not in correo or "." not in correo.split("@")[-1]:
            raise ValidationError("El correo electrónico no tiene un formato válido.")
        return correo.strip().lower()

    @property
    def nombre(self):
        return self.__nombre

    @property
    def correo(self):
        return self.__correo

    @property
    def telefono(self):
        return self.__telefono

    def describir(self):
        return f"Cliente {self.id}: {self.nombre} | {self.correo} | {self.telefono}"





